{
  "name": "weathershopper-task",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI tests for the Weather Shopper demo shop",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:ui": "playwright test --project=chromium-e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium-e2e --headed",
    "test:debug": "playwright test --project=chromium-e2e --debug",
    "test:ui-mode": "playwright test --ui",
    "test:stress": "playwright test tests/ui/checkout-journey.spec.ts --repeat-each=30 --workers=6",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Salem Iskander",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
